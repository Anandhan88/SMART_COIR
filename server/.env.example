# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-coir
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-coir

# JWT
JWT_SECRET=smart-coir-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=smart-coir-refresh-secret-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# OpenAI (for AI Chatbot)
OPENAI_API_KEY=your-openai-api-key-here

# Email (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL
CLIENT_URL=http://localhost:3000
